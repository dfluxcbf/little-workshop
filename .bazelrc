build --python_path=python3
build --color=yes

# //:test shells out to the system `python3 -m pytest` rather than using a
# hermetic rules_python toolchain, so it needs $HOME to find user-installed
# packages (fastapi, uvicorn, httpx, pydantic, pytest). The integration
# tests additionally exercise a *real* `systemd --user` session (transient
# units, real Unix-domain-socket Pillar Interface calls — see
# docs/milestones.md M1's "proven end-to-end" requirement), which needs
# XDG_RUNTIME_DIR and the D-Bus session address to reach that session.
test --test_env=HOME
test --test_env=PATH
test --test_env=XDG_RUNTIME_DIR
test --test_env=DBUS_SESSION_BUS_ADDRESS
test --test_output=errors
